{
  "name": "magpie-updates",
  // Copy into .wrangler/update-config.jsonc and fill in your deployment values.
  "account_id": "YOUR_CLOUDFLARE_ACCOUNT_ID",
  "main": "../update-worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "updates.example.com", "custom_domain": true }
  ],
  "define": {
    "MAGPIE_RELEASE_REPO": "\"zhumengstarsea/magpie\"",
    "MAGPIE_UPDATE_ORIGIN": "\"https://updates.example.com\""
  },
  "kv_namespaces": [
    { "binding": "LEDGER", "id": "YOUR_LEDGER_KV_NAMESPACE_ID" }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }
}
